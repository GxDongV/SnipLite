<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>SnipLite.PluginChecks</AssemblyName>
    <RootNamespace>SnipLiteChecks</RootNamespace>
    <OutputPath Condition="'$(CheckOutputSuffix)' != ''">bin/$(Configuration)/$(CheckOutputSuffix)/</OutputPath>
    <ApplicationManifest>../../src/SnipLite/app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SnipLite/SnipLite.csproj" />
    <ProjectReference Include="../../src/SnipLite.ScrollCapture/SnipLite.ScrollCapture.csproj" />
    <ProjectReference Include="../PluginFixture/PluginFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
