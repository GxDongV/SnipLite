<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.1.15</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SnipLite.Plugin.Abstractions/SnipLite.Plugin.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets/scroll-capture.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets/scroll-capture.png" LogicalName="SnipLite.ScrollCapture.Icon.png" />
    <InternalsVisibleTo Include="SnipLite.PluginChecks" />
  </ItemGroup>
</Project>
