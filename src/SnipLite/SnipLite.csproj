<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- OCR runs through SimdPaddle; no Windows Runtime projections are used. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../logo/SnipLite.ico</ApplicationIcon>
    <AssemblyName>SnipLite</AssemblyName>
    <RootNamespace>SnipLite</RootNamespace>
    <Version>0.3.16</Version>
    <Description>A Windows screenshot and pinning tool with local OCR and barcode recognition.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GxDongV/SnipLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SnipLite.Plugin.Abstractions/SnipLite.Plugin.Abstractions.csproj" />
    <ProjectReference Include="../SnipLite.ScrollCapture/SnipLite.ScrollCapture.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      UndefineProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <EmbeddedResource Include="Localization/Resources/*.json" LogicalName="SnipLite.Localization.%(Filename).json" />
    <InternalsVisibleTo Include="SnipLite.SelfTest" />
    <InternalsVisibleTo Include="SnipLite.PluginChecks" />
    <EmbeddedResource Include="../../logo/SnipLite.ico" LogicalName="SnipLite.AppIcon.ico" />
    <EmbeddedResource Include="Assets/PaperFold.wav" LogicalName="SnipLite.PaperFold.wav" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Small" Version="1.0.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.17" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="SnipLite.Notices.LICENSE" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="SnipLite.Notices.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="../../licenses/**/*.txt">
      <LogicalName>SnipLite.Notices.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CollectBundledPlugins" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../SnipLite.ScrollCapture/SnipLite.ScrollCapture.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile">
      <Output TaskParameter="TargetOutputs" ItemName="_ScrollPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_ScrollPluginAssembly)" LogicalName="SnipLite.Bundled.ScrollCapture.dll" />
      <EmbeddedResource Include="@(_ScrollPluginAssembly->'%(RootDir)%(Directory)SnipLite.ScrollCapture.deps.json')" LogicalName="SnipLite.Bundled.ScrollCapture.deps.json" />
      <EmbeddedResource Include="../SnipLite.ScrollCapture/plugin.json" LogicalName="SnipLite.Bundled.ScrollCapture.plugin.json" />
      <EmbeddedResource Include="../SnipLite.ScrollCapture/assets/scroll-capture.png" LogicalName="SnipLite.Bundled.ScrollCapture.icon.png" />
    </ItemGroup>
  </Target>


</Project>
