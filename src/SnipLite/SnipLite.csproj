<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SnipLite</AssemblyName>
    <RootNamespace>SnipLite</RootNamespace>
    <Version>0.3.9</Version>
    <Description>A Windows screenshot and pinning tool with local OCR and barcode recognition.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GxDongV/SnipLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnipLite.SelfTest" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Small" Version="1.0.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.17" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="SnipLite.Notices.LICENSE" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="SnipLite.Notices.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="../../licenses/**/*.txt">
      <LogicalName>SnipLite.Notices.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
